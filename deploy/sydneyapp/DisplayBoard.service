[Unit]
Description=DisplayBoard app
After=network.target

# Limit restart attempts (3 times in 60 seconds)
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
ExecStart=/home/nick/scripts/DisplayBoard/scripts/launch.sh
WorkingDirectory=/home/nick/scripts/DisplayBoard
StandardOutput=journal
StandardError=journal
User=nick
EnvironmentFile=/home/nick/.config/op/service-account-token
Environment=PATH=/home/nick/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Logging and restart behavior
# Only restart on non-zero exit code and wait 10 seconds before restarting
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target